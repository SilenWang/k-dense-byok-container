# K-Dense BYOK container
#
# Copy this file to .env, fill in your keys, then launch:
#   docker compose up -d
# or (with pixi):
#   pixi run up
#
# GPU support (requires NVIDIA Container Toolkit):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
#
# NOT limited to OpenRouter — K-Dense BYOK accepts several model sources:
#   1. OpenRouter key            -> OPENROUTER_API_KEY below
#   2. NVIDIA NIM key            -> NVIDIA_API_KEY below
#   3. Subscriptions (ChatGPT Plus/Pro, Claude Pro/Max, GitHub Copilot,
#      xAI): no API key needed — connect in-app under
#      Settings → Model providers (OAuth). Tokens persist in the kady-home
#      volume, no .env entry required.
#   4. Local models: Ollama or any OpenAI-compatible server
#      (LM Studio / vLLM / ...) -> OLLAMA_BASE_URL / OPENAI_COMPATIBLE_BASE_URL
#   5. Modal cloud GPU compute   -> MODAL_TOKEN_ID / MODAL_TOKEN_SECRET

# --- Model access (choose at least one) ---

# OpenRouter API key (broadest model access: OpenAI, Anthropic, Google, ...)
OPENROUTER_API_KEY=

# Optional: point OpenRouter at any OpenAI-compatible gateway instead
# (e.g. Requesty). OPENROUTER_API_KEY above then holds that gateway's key.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM API key (build.nvidia.com) — Nemotron, Llama, GPT-OSS, ...
# NVIDIA_API_KEY=

# Local OpenAI-compatible server (LM Studio / vLLM / llama.cpp ...).
# "host.docker.internal" reaches a server running on the Docker host.
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234

# Modal remote compute (cloud CPU/GPU)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Host Ollama ---
# Default points at the Docker HOST's Ollama via host.docker.internal.
# If using the bundled GPU sidecar, set:
#   OLLAMA_BASE_URL=http://ollama:11434
# and launch with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile ollama up -d
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Model defaults ---
# DEFAULT_MODEL_PROVIDER: openrouter | ollama | nvidia | openai-codex |
#                         anthropic | github-copilot | xai
# DEFAULT_MODEL_ID must match the chosen provider's model id.
DEFAULT_MODEL_ID=anthropic/claude-opus-5
DEFAULT_MODEL_PROVIDER=openrouter

# --- Ports (override if already in use) ---
# KADY_UI_PORT=3000
# KADY_API_PORT=8000

# --- Optional web-access keys (search / fetching) ---
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=

# --- Proxy (optional) ---
# HTTPS_PROXY=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1
