+/**
+ * True when `origin` is served from the same host as `host` (the request's
+ * Host header), regardless of port. This lets a container accessed at
+ * `http://<host>:<ui>` call the API at `http://<host>:<api>` for hosts that
+ * fall outside the private ranges above (e.g. a domain name).
+ */
+export function isSameHostOrigin(
+  origin: string | undefined,
+  host: string | undefined,
+): boolean {
+  if (!origin || !host) return false;
+  try {
+    return new URL(origin).hostname === host.split(":")[0];
+  } catch {
+    return false;
+  }
+}
